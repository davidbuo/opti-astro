---
import { Image as AstroImage } from 'astro:assets';

import { getCurrentLocale, getRelativeLocaleUrl } from '../../lib/locale-utils';
import type { SiteSettingsByHostnameQuery } from '../../../__generated/sdk';
import { getClassForLogo } from './siteSettingsHelper';
// Removed SearchPalette and ThemePicker for cleaner navigation
// import { getMenuItems } from './siteSettingsHelper';
const lang = getCurrentLocale(Astro);

// Define interfaces for the menu items to fix TypeScript errors
interface LinkType {
    text: string;
    url: {
        default: string;
    };
}

interface MenuItemType {
    Link: LinkType;
    LinkText?: string;
    SubMenuItems?: MenuItemType[];
}

interface Props {
    siteSettings: SiteSettingsByHostnameQuery;
}

const { siteSettings } = Astro.props;
const settings = siteSettings?.SiteSettings?.item;

const logoUrl =
    (settings?.Logo as any)?.item?.Url || settings?.Logo?.url?.default || null;
const logoCss = getClassForLogo(settings?.LogoResolution);

const headerItems = settings?.HeaderLinks as MenuItemType[] | undefined;
const headerItemCount = headerItems?.length || 0;
---

<header class="sticky top-0 z-50 bg-gray-50/70 backdrop-blur-sm">
    <div class="navbar bg-base-100 shadow-sm">
        <div class="navbar-start">
            <a class="text-neutral nestly-heading block px-8" href="/">
                <span class="sr-only">Home</span>
                <span class="text-2xl font-bold">Nestly</span>
            </a>
        </div>
        <div class="navbar-center">
            <!-- Navigation Links for Desktop - Centered -->
            <div class="hidden items-center gap-8 lg:flex">
                {
                    headerItems &&
                        headerItemCount > 0 &&
                        headerItems.map((data) => (
                            <a
                                class="text-neutral hover:text-primary transition-colors"
                                href={data?.Link?.url?.default || '#'}
                            >
                                {data?.LinkText || data?.Link?.text || ''}
                            </a>
                        ))
                }
            </div>
        </div>
        <div class="navbar-end gap-4" x-data="{}">
            <!-- Desktop Action Buttons -->
            <div class="hidden items-center gap-3 lg:flex">
                <button
                    class="btn btn-ghost text-neutral hover:text-primary gap-2 transition-colors"
                    @click="window.dispatchEvent(new CustomEvent('open-command-palette'))"
                >
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                    </svg>
                    <span>Search</span>
                </button>
                <a
                    href="https://app-epsadabuoas7yk1mp001.cms.optimizely.com/ui/cms"
                    class="btn btn-ghost text-neutral hover:text-primary gap-2 transition-colors"
                >
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                        ></path>
                    </svg>
                    <span>Login</span>
                </a>
                <a href="#" class="btn btn-primary">GET STARTED</a>
            </div>
            
            <!-- Mobile Hamburger Menu -->
            <div class="dropdown dropdown-end lg:hidden">
                <label tabindex="0" class="btn btn-ghost btn-circle">
                    <div class="flex flex-col gap-1">
                        <div class="w-5 h-0.5 bg-black"></div>
                        <div class="w-5 h-0.5 bg-black"></div>
                        <div class="w-5 h-0.5 bg-black"></div>
                    </div>
                </label>
                <ul
                    tabindex="0"
                    class="menu menu-sm dropdown-content bg-white rounded-box z-[1] mt-3 w-52 p-4 shadow-lg border"
                >
                    <!-- Header Links -->
                    {
                        headerItems &&
                            headerItemCount > 0 &&
                            headerItems.map((data) => (
                                <li>
                                    <a 
                                        href={data?.Link?.url?.default || '#'}
                                        class="text-neutral hover:text-primary transition-colors"
                                    >
                                        {data?.LinkText ||
                                            data?.Link?.text ||
                                            ''}
                                    </a>
                                </li>
                            ))
                    }
                    
                    <!-- Divider if header links exist -->
                    {headerItemCount > 0 && <div class="divider my-2"></div>}
                    
                    <!-- Action Items -->
                    <li>
                        <button
                            class="flex items-center gap-2 text-neutral hover:text-primary transition-colors w-full justify-start"
                            @click="window.dispatchEvent(new CustomEvent('open-command-palette'))"
                        >
                            <svg
                                class="h-4 w-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                ></path>
                            </svg>
                            Search
                        </button>
                    </li>
                    <li>
                        <a 
                            href="https://app-epsadabuoas7yk1mp001.cms.optimizely.com/ui/cms"
                            class="flex items-center gap-2 text-neutral hover:text-primary transition-colors"
                        >
                            <svg
                                class="h-4 w-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                ></path>
                            </svg>
                            Login
                        </a>
                    </li>
                    
                    <!-- Primary CTA at bottom -->
                    <div class="divider my-2"></div>
                    <li>
                        <a href="#" class="btn btn-primary btn-sm w-full">
                            GET STARTED
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>
