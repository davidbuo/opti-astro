---
import { Font } from 'astro:assets';
import { ASTRO_TRANSITIONS_ENABLED } from 'astro:env/client';
import { ClientRouter } from 'astro:transitions';

import type { Locales } from '../../__generated/sdk';
import Footer from '../cms/shared/Footer.astro';
import Header from '../cms/shared/Header.astro';
import SiteStyles from '../cms/components/SiteStylesComponent/SiteStyles.astro';
import { getSiteFont } from '../cms/shared/siteStylesHelper';
import { EXTERNAL_PREVIEW_ENABLED, OPTIMIZELY_DATA_PLATFORM_PRIVATE_KEY } from 'astro:env/server';
import ExtPreviewLinkBanner from '../cms/shared/ExtPreviewLink/ExtPreviewLinkBanner.astro';
import DataPlatform from '../cms/shared/DataPlatform/DataPlatform.astro';
// import { getOdpScript } from '../cms/shared/DataPlatform/dataPlatform.ts';
import { isDraftContent, isEditContext } from '../cms/shared/utils.ts';
import { getOptimizelySdk } from '../graphql/getSdk';
import type { ContentPayload } from '../graphql/shared/ContentPayload';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    graphtype?: string;
    indexing?: boolean;
    contentPayload: ContentPayload;
    defaultUrl?: string;
    hierarchicalUrl?: string;
    extPreviewEnabled?: boolean;
}

const {
    title,
    description,
    graphtype = 'website',
    indexing = false,
    contentPayload,
    defaultUrl,
    hierarchicalUrl,
    extPreviewEnabled,
} = Astro.props;
const ctx = contentPayload.ctx || 'view';

const isCmsEdit = isEditContext(Astro.url);

const contentVersion = contentPayload.ver || '';
const isDraft = EXTERNAL_PREVIEW_ENABLED && extPreviewEnabled && await isDraftContent(contentVersion);

const { host } = Astro.url;

// Debug domain resolution
console.log('=== Domain Resolution Debug ===');
console.log('Original Host:', host);
console.log('Full URL:', Astro.url.href);
console.log('URL hostname:', Astro.url.hostname);
console.log('URL origin:', Astro.url.origin);
console.log('URL protocol:', Astro.url.protocol);
console.log('URL port:', Astro.url.port);
console.log('Is localhost?', host.includes('localhost'));
console.log('Is Vercel?', host.includes('vercel.app'));
console.log('Is opti-demo.com?', host.includes('opti-demo.com'));
console.log('================================');

// First try with the original host
console.log('=== GraphQL Query Parameters ===');
console.log('contentPayload:', contentPayload);
console.log('contentPayload.loc:', contentPayload.loc);
console.log('Locale array:', [contentPayload.loc as Locales]);
console.log('Domain parameter:', host);
console.log('================================');

let siteSettings = await getOptimizelySdk(
    contentPayload
).siteSettingsByHostname({
    domain: host,
    locale: [contentPayload.loc as Locales],
});

console.log('=== First Query Result ===');
console.log('Query domain:', host);
console.log('Found site settings:', !!siteSettings?.SiteSettings?.item);
console.log('Site domain in result:', siteSettings?.SiteSettings?.item?.SiteDomain);

// If no site settings found, let's analyze what we should try next
if (!siteSettings?.SiteSettings?.item) {
    console.log('=== No Site Settings Found - Analyzing Host ===');
    
    // For now, let's just log this case and see what we're dealing with
    // We should avoid hardcoded fallbacks and instead:
    // 1. Check if this is a deployment URL that should map to a production domain
    // 2. Or if the CMS simply doesn't have this domain configured
    
    console.log('Host analysis:');
    console.log('- Is deployment URL?', host.includes('vercel.app') || host.includes('netlify.app') || host.includes('herokuapp.com'));
    console.log('- Is localhost?', host.includes('localhost'));
    console.log('- Is production domain?', host.includes('opti-demo.com') || (!host.includes('vercel') && !host.includes('localhost')));
    
    // TODO: Instead of hardcoded fallbacks, we should either:
    // A) Have a way to query all site settings and find one that matches
    // B) Have environment variables that map deployment URLs to production domains
    // C) Configure the deployment domain properly in the CMS
    
    console.log('WARNING: No site settings found for domain:', host);
    console.log('Please ensure this domain is configured in CMS Site Settings > Site Domain');
    console.log('================================================');
}

const optiWebProjectId = siteSettings?.SiteSettings?.item?.OptiWebProjectId || null;

// Debug logging for optiWebProjectId
console.log('=== Final OptiWeb Debug Info ===');
console.log('Original Host:', host);
console.log('Final Site Settings Item:', siteSettings?.SiteSettings?.item);
console.log('Site Domain from CMS:', siteSettings?.SiteSettings?.item?.SiteDomain);
console.log('OptiWebProjectId from CMS:', siteSettings?.SiteSettings?.item?.OptiWebProjectId);
console.log('Final optiWebProjectId:', optiWebProjectId);
console.log('isCmsEdit:', isCmsEdit);
console.log('Will load Optimizely script?', !isCmsEdit && !!optiWebProjectId);
console.log('================================');
const pageVariationWeb = Astro.url.searchParams.get('var') || null;

const odpEnabled = !!OPTIMIZELY_DATA_PLATFORM_PRIVATE_KEY;
const odpPublicKey = odpEnabled && OPTIMIZELY_DATA_PLATFORM_PRIVATE_KEY?.split('.')[0];
// const odpScript = odpPublicKey && getOdpScript(odpPublicKey);

console.log('=== Site Styles Query Debug ===');
console.log('Domain for styles query:', host);
console.log('Locale for styles query:', [contentPayload.loc as Locales]);

const siteStyles = await getOptimizelySdk(contentPayload).siteStylesByHostname({
    domain: host,
    locale: [contentPayload.loc as Locales],
});

console.log('Site styles found:', !!siteStyles?.SiteStyles?.item);
console.log('Site styles domain:', siteStyles?.SiteStyles?.item?.SiteStylesDomain);
console.log('===============================');

const siteFont = getSiteFont(siteStyles?.SiteStyles?.item);

const externalStylesUrl = siteStyles?.SiteStyles?.item?.cssFile?._metadata?.url?.default || null;

const canonicalUrl = Astro.url.origin + hierarchicalUrl;

const graphType = graphtype !== '-' ? graphtype : 'website';
const contentKey = contentPayload.key || '';

---

<!doctype html>
<html data-theme="nestly" lang="en">
    <head>
        <meta charset="UTF-8" />
{(() => {
            const shouldLoadOpti = !isCmsEdit && optiWebProjectId;
            console.log('=== Script Loading Decision ===');
            console.log('Should load Optimizely script:', shouldLoadOpti);
            console.log('Script URL would be:', shouldLoadOpti ? `https://cdn.optimizely.com/js/${optiWebProjectId}.js` : 'N/A');
            console.log('===============================');
            
            if (shouldLoadOpti) {
                return (
                    <>
                        <link rel="preload" href={`//cdn.optimizely.com/js/${optiWebProjectId}.js`} as="script" />
                        <link rel="preconnect" href="//logx.optimizely.com" />
                        <script src={`https://cdn.optimizely.com/js/${optiWebProjectId}.js`} />
                    </>
                );
            }
            return null;
        })()}
        {odpEnabled && (
            <DataPlatform odpPublicKey={odpPublicKey} />
        )}
        {siteStyles && <SiteStyles siteStyles={siteStyles} />}
        {siteFont && <Font cssVariable={siteFont} preload />}
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        { externalStylesUrl && (
            <>
                <link rel="preload" href={externalStylesUrl} as="style" />
                <link rel="stylesheet" href={externalStylesUrl} />
            </>
        )}
        <meta name="generator" content={Astro.generator} />
        {indexing && <meta name="robots" content="noindex, nofollow" />}
        {graphType && <meta property="og:type" content={graphType} />}
        {hierarchicalUrl && <link rel="canonical" href={canonicalUrl} />}
        <title>{title}</title>
        {ASTRO_TRANSITIONS_ENABLED && <ClientRouter />}
    </head>
    <body data-content-key={contentKey}>
        {
            EXTERNAL_PREVIEW_ENABLED && extPreviewEnabled && isDraft 
                && (ctx === 'edit' || ctx === 'ext_preview') && (
                <ExtPreviewLinkBanner
                    contentPayload={contentPayload}
                    pageUrl={defaultUrl}
                />
            )
        }
        {(() => {
            console.log('=== Header Site Settings Debug ===');
            console.log('Site settings being passed to Header:', siteSettings?.SiteSettings?.item);
            console.log('HeaderLinks being passed:', siteSettings?.SiteSettings?.item?.HeaderLinks);
            console.log('HeaderLinks count:', siteSettings?.SiteSettings?.item?.HeaderLinks?.length || 0);
            console.log('=====================================');
            return null;
        })()}
        <Header siteSettings={siteSettings} />
        <slot />
        <Footer siteSettings={siteSettings} />

        {
            ASTRO_TRANSITIONS_ENABLED && !isCmsEdit && optiWebProjectId && (
                <script is:inline>
                    document.addEventListener('astro:page-load', () => {
                        // The Optimizely snippet creates a global array `window.optimizely`.
                        // We push events to this array to signal page changes, which is the
                        // standard practice for Single-Page Applications.
                        // See: https://docs.developers.optimizely.com/web-experimentation/docs/single-page-applications-and-dynamic-websites
                        if (window.optimizely) {
                            window.optimizely.push({ type: 'activate' });
                        }
                    });
                </script>
            )
        }
        <script>
            import Alpine from 'alpinejs';

            // Make Alpine available globally
            window.Alpine = Alpine;

            // Start Alpine
            Alpine.start();
        </script>
    </body>
</html>
